# Placeholders only. Never commit real values. Only VITE_* values are exposed to the browser,
# so never put a service-role key or any secret here.

# Display name of the app (configurable).
VITE_APP_NAME=MotherCare

# Supabase project (Settings -> API). The anon key is designed to be public;
# data protection relies on Row Level Security (added in Phase 3).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Development-only sign-in fallback used when Supabase is not configured.
# It does NOT verify passwords. It is always available under `npm run dev`;
# set to "true" only if you deliberately want it in a production build (not recommended).
VITE_ALLOW_DEV_AUTH=false

# ISO 4217 code used to display prices in the shopping list (display only). Default: NGN.
VITE_CURRENCY_CODE=NGN
VITE_COUNTRY_CODE=NG
